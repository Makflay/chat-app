# ==========================
# Backend
# ==========================

PORT=5000

# PostgreSQL - Local development
# Use this if PostgreSQL is installed locally
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/chat_app_db?schema=public"

# JWT
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=1d

# ==========================
# Seed Admin
# ==========================

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ==========================
# Seed Bot Configuration
# ==========================

# Bot account email
# Used for authentication and sending messages
BOT_EMAIL=bot@mail.com

# Bot account password
# Authentication is not required, you can leave as NO_LOGIN
BOT_PASSWORD=NO_LOGIN

# Display name of the bot
BOT_NAME=Assistant


# ==========================
# YandexGPT / Yandex Cloud
# ==========================

# Service account ID / API key ID
# Get it from: https://console.cloud.yandex.ru/
YANDEX_KEY_ID=

# Yandex Cloud API key
YANDEX_API_KEY=

# YandexGPT model URI
# Example:
# gpt://<folder_id>/yandexgpt-lite/latest
YANDEX_MODEL_URI=

# ==========================
# Global Chat
# ==========================

SYSTEM_GROUP_KEY=SYSTEM_GROUP_KEY

# ==========================
# Frontend
# ==========================

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000